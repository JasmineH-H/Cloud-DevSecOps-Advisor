# Terraform state files
*.tfstate
*.tfstate.*

# Terraform lock file (optional: keep or ignore depending on team)
.terraform.lock.hcl

# Terraform directory
.terraform/

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Crash logs
crash.log

# AWS credentials (extra safety)
.aws/

# macOS
.

# Frontend env (VITE_API_URL for production builds)
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Lambda build artifacts
lambda/pentest-trigger/node_modules/
lambda/pentest-trigger/pentest-trigger.zip

# Scanner dependencies and local artifacts
scanner/**/node_modules/
scanner/**/__pycache__/
scanner/out.json

# Output and response files
infrastructure/output.json                                                                                                                                         
infrastructure/response.json
output.json                                                                                                                                                        
response.json 
