# Copy to terraform.tfvars (gitignored) and customize if needed.
#
# Optional: pentest a URL other than the Juice Shop ALB in this stack.
# pentest_target_url = "http://your-vulnerable-app-alb.region.elb.amazonaws.com"
#
# Optional: label stored with pentest results (matches dashboard repo filter).
# pentest_repo_name = "vulnerable-node-app"

# Optional: IAM role name used by ECS tasks and the pentest Lambda.
# Learner Lab keeps the default `LabRole`.
# iam_role_name = "LabRole"
#
# Optional: override DynamoDB table name (default: "<project_name>-scan-results")
# scan_results_table_name = "devsecops-advisor-scan-results"
#
# Optional: ACM certificate ARN for HTTPS ALB listener (HTTP will redirect to HTTPS when set)
# alb_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
